# Supabase configuration for GM TỰ (https://supabase.com)
# Obtain these values from your Supabase Dashboard: Project Settings -> API

# Frontend (Vite) - public anon credentials
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Backend / Serverless (Vercel Functions) - private service role
# DO NOT expose SUPABASE_SERVICE_ROLE_KEY to client code or commit real keys to git!
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

